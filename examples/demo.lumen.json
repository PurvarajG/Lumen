        {
          "id": "4e56c632-9dc7-4c26-9683-8e83ee61ea82",
          "label": "Chorus",
          "text": "Hope rises up; we sing as one.",
          "notes": "Keep this cue through the refrain.",
          "theme_id": "062b0c66-ebe9-4e04-aaf2-5dfbe22cf4c3",
          "background": {
